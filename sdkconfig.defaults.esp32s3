CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console on the native USB (USB Serial/JTAG, GPIO19/20). UART0's pads are GPIO43/44, which this
# board's LCD drives as DC/CS — the moment esp_lcd claims them the UART console goes deaf mid-byte.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
